# Frontend Supabase configuration.
# Use the project's publishable key, or its legacy anon key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# FalkorDB memory service (server-side only; never prefix these with VITE_).
FALKORDB_URL=redis://localhost:6379
MEMORY_SERVICE_SECRET=replace-with-a-long-random-secret
MEMORY_SERVICE_URL=http://localhost:3001
MEMORY_BACKEND=falkordb

# One-time legacy memory import only. Never use the service-role key in VITE_*.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
